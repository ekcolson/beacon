# This repo lives on a Windows filesystem but is edited from WSL, which
# otherwise leaves CRLF in the working tree and makes every file look rewritten
# in a diff. Normalize to LF in the repository regardless of checkout.
* text=auto eol=lf

# Windows-only scripts need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
